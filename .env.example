# Copy to .env and fill in. Never commit the filled-in file.

# PostgreSQL connection string. `npm run db:up` starts a matching local container.
DATABASE_URL="postgresql://resources:resources@localhost:5433/resources_iiith?schema=public"

# Canonical URL of the deployment. Required in production.
NEXTAUTH_URL="http://localhost:3000"

# Signing key for session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
